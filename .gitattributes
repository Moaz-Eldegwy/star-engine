# Normalize line endings across platforms
* text=auto eol=lf

# Text formats (force LF)
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.ipynb text eol=lf

# Treat as binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.bin   binary
*.woff  binary
*.woff2 binary
*.zip   binary
