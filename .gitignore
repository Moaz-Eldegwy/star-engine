# --- Raw paper artifacts (large, re-fetchable from PMC) ---
# 494 paper folders contain full_text.xml (~65 MB total), graph_extract.json,
# and {pmc_id}.json. The runtime only needs publications.json and the
# precomputed index in public/data/index/. The raw papers can be rebuilt
# locally via scripts/fetch_raw_xml.py + notebooks/01_fetch_and_parse.ipynb.
data/papers/
data/raw/
data/temp_xml_downloads/

